<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="21507" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21505"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view customClass="GADNativeAdView" customModule="GoogleMobileAds" id="iN0-l3-epB">
            <rect key="frame" x="0.0" y="0.0" width="393" height="150"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
            <subviews>
                <!-- Главный контейнер (эквивалент внутреннего LinearLayout с отступами и фоном) -->
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="ContainerView">
                    <rect key="frame" x="10" y="0.0" width="373" height="136"/>
                    <subviews>
                        
                        <!-- Верхняя строка: Заголовок + Плашка "Жарнама" -->
                        <stackView opaque="NO" contentMode="scaleToFill" spacing="8" alignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="TopStack">
                            <rect key="frame" x="0.0" y="0.0" width="373" height="21.666666666666668"/>
                            <subviews>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Headline" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ad_headline">
                                    <rect key="frame" x="0.0" y="0.0" width="318.33333333333331" height="21.666666666666668"/>
                                    <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                                    <color key="textColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                    <nil key="highlightedColor"/>
                                </label>
                                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="252" verticalHuggingPriority="251" text="Жарнама" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ad_attribution">
                                    <rect key="frame" x="326.33333333333331" y="3.6666666666666661" width="46.666666666666686" height="14.333333333333336"/>
                                    <fontDescription key="fontDescription" type="system" pointSize="12"/>
                                    <color key="textColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                    <nil key="highlightedColor"/>
                                </label>
                            </subviews>
                        </stackView>

                        <!-- Нижняя строка: Иконка + Правый блок (Текст + Кнопка) -->
                        <stackView opaque="NO" contentMode="scaleToFill" alignment="top" spacing="10" translatesAutoresizingMaskIntoConstraints="NO" id="BottomStack">
                            <rect key="frame" x="0.0" y="27.666666666666671" width="373" height="100"/>
                            <subviews>
                                <!-- Иконка рекламы -->
                                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="ad_icon">
                                    <rect key="frame" x="0.0" y="0.0" width="150" height="100"/>
                                    <constraints>
                                        <constraint firstAttribute="width" constant="150" id="iconW"/>
                                        <constraint firstAttribute="height" constant="100" id="iconH"/>
                                    </constraints>
                                </imageView>

                                <!-- Правый вертикальный блок (Body + CTA Button) -->
                                <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" alignment="bottom" spacing="16" translatesAutoresizingMaskIntoConstraints="NO" id="RightStack">
                                    <rect key="frame" x="160" y="0.0" width="213" height="88"/>
                                    <subviews>
                                        <!-- Описание -->
                                        <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Body description text goes here..." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="2" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="ad_body">
                                            <rect key="frame" x="0.0" y="0.0" width="213" height="33.666666666666664"/>
                                            <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                            <color key="textColor" white="0.0" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                            <nil key="highlightedColor"/>
                                        </label>

                                        <!-- Кнопка действия -->
                                        <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ad_call_to_action">
                                            <rect key="frame" x="127" y="49.666666666666657" width="86" height="38.333333333333343"/>
                                            <color.backgroundColor>
                                                <color red="0.086274509803921569" green="0.59215686274509804" blue="0.81960784313725488" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </color.backgroundColor>
                                            <inset key="contentEdgeInsets" minX="12" minY="10" maxX="12" maxY="10"/>
                                            <state key="normal" title="Button">
                                                <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                            </state>
                                            <userDefinedRuntimeAttributes>
                                                <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                                    <integer key="value" value="6"/>
                                                </userDefinedRuntimeAttribute>
                                            </userDefinedRuntimeAttributes>
                                        </button>
                                    </subviews>
                                    <constraints>
                                        <constraint firstItem="ad_body" firstAttribute="width" secondItem="RightStack" secondAttribute="width" id="bodyWidth"/>
                                    </constraints>
                                </stackView>
                            </subviews>
                        </stackView>

                    </subviews>
                    <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                    <constraints>
                        <constraint firstItem="TopStack" firstAttribute="top" secondItem="ContainerView" secondAttribute="top" id="topConst"/>
                        <constraint firstItem="TopStack" firstAttribute="leading" secondItem="ContainerView" secondAttribute="leading" id="topLeft"/>
                        <constraint firstAttribute="trailing" secondItem="TopStack" secondAttribute="trailing" id="topRight"/>
                        
                        <constraint firstItem="BottomStack" firstAttribute="top" secondItem="TopStack" secondAttribute="bottom" constant="6" id="botTop"/>
                        <constraint firstItem="BottomStack" firstAttribute="leading" secondItem="ContainerView" secondAttribute="leading" id="botLeft"/>
                        <constraint firstAttribute="trailing" secondItem="BottomStack" secondAttribute="trailing" id="botRight"/>
                        <constraint firstAttribute="bottom" secondItem="BottomStack" secondAttribute="bottom" id="botBottom"/>
                    </constraints>
                </view>
            </subviews>
            <viewLayoutGuide key="safeArea" id="vUN-kp-3ea"/>
            <color key="backgroundColor" white="0.0" alpha="0.0" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="ContainerView" firstAttribute="leading" secondItem="vUN-kp-3ea" secondAttribute="leading" constant="10" id="contLead"/>
                <constraint firstItem="vUN-kp-3ea" firstAttribute="trailing" secondItem="ContainerView" secondAttribute="trailing" constant="10" id="contTrail"/>
                <constraint firstItem="ContainerView" firstAttribute="top" secondItem="iN0-l3-epB" secondAttribute="top" id="contTop"/>
            </constraints>
            <freeformSimulatedSizeMetrics key="simulatedDestinationMetrics"/>
            <connections>
                <outlet property="bodyView" destination="ad_body" id="outBody"/>
                <outlet property="callToActionView" destination="ad_call_to_action" id="outCTA"/>
                <outlet property="headlineView" destination="ad_headline" id="outHead"/>
                <outlet property="iconView" destination="ad_icon" id="outIcon"/>
            </connections>
        </view>
    </objects>
    <resources>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>